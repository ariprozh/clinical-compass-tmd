    function restoreDraft() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY_DRAFT);
        if (!raw) return;
        const draft = JSON.parse(raw);

        if (draft.participantId) document.getElementById('participant-id').value = draft.participantId;
        if (draft.visitId) document.getElementById('visit-id').value = draft.visitId;
        document.getElementById('age-18-check').checked = !!draft.age18;
        document.getElementById('acute-trauma-check').checked = !!draft.acuteTrauma;
        document.getElementById('consent-signed-check').checked = !!draft.consentSigned;
        consentTimestampISO = draft.consentTimestampISO || null;
        if (consentTimestampISO && draft.age18 && draft.acuteTrauma && draft.consentSigned) {
          document.getElementById('consent-timestamp-display').textContent = consentTimestampISO;
          document.getElementById('consent-timestamp-box').classList.remove('hidden');
        }

        if (Array.isArray(draft.painZones)) {
          selectedPainZones.clear();
          draft.painZones.forEach(z => selectedPainZones.add(z));
        }
        document.getElementById('no-pain-zones-check').checked = !!draft.noPainZones;
        syncPainZonesUI();

        if (draft.sliders) {
          Object.keys(draft.sliders).forEach(id => {
            const el = document.getElementById(id);
            if (el) el.value = draft.sliders[id];
          });
        }
        if (draft.skips) {
          Object.keys(draft.skips).forEach(id => {
            const skipEl = document.getElementById(`skip-${id}`);
            const sliderEl = document.getElementById(id);
            if (skipEl && sliderEl) {
              skipEl.checked = !!draft.skips[id];
              sliderEl.disabled = !!draft.skips[id];
            }
            updateSliderBadge(id, `val-${id}`);
          });
        }

        if (draft.phq4) {
          Object.keys(draft.phq4).forEach(id => {
            const radio = document.querySelector(`input[name="${id}"][value="${draft.phq4[id]}"]`);
            if (radio) radio.checked = true;
          });
          checkPhq4SafetyAlert();
        }

        if (draft.treatmentChange) {
          const tc = document.querySelector(`input[name="treatment-change"][value="${draft.treatmentChange}"]`);
          if (tc) tc.checked = true;
        }
        if (draft.treatmentNotes) {
          document.getElementById('treatment-notes').value = draft.treatmentNotes;
        }
      } catch (e) {
        // Ignore malformed draft
      }
    }

