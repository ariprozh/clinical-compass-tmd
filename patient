        const consentOk = document.getElementById('consent-signed-check').checked;

        if (!pid) {
          showValidationError('Введите псевдонимизированный код участника (participant_id) или нажмите «Сгенерировать демо-код».');
          return false;
        }
        if (!ageOk) {
          showValidationError('Необходимо подтвердить критерий включения: «Мне исполнилось 18 лет».');
          return false;
        }
        if (!traumaOk) {
          showValidationError('Необходимо подтвердить отсутствие острой челюстно-лицевой травмы или неотложного состояния.');
          return false;
        }
        if (!consentOk) {
          showValidationError('Для перехода к анкетированию необходимо дать добровольное информированное согласие.');
          return false;
        }
        if (!consentTimestampISO) {
          consentTimestampISO = new Date().toISOString();
        }
      }

      if (step === 3) {
        const noPainChecked = document.getElementById('no-pain-zones-check').checked;
        if (selectedPainZones.size === 0 && !noPainChecked) {
          showValidationError('Отметьте хотя бы одну анатомическую зону боли на схеме или установите флажок «За последние 30 дней боли в указанных зонах не было».');
          return false;
        }
      }

      return true;
    }

    function goToStep(step) {
      currentStep = step;

      document.querySelectorAll('.wizard-step').forEach((el, index) => {
        el.classList.toggle('hidden', index + 1 !== currentStep);
      });

      const percent = Math.round((currentStep / totalSteps) * 100);
      document.getElementById('step-label').textContent = STEP_TITLES[currentStep];
      document.getElementById('step-percent').textContent = `${percent}%`;
      document.getElementById('progress-bar').style.width = `${percent}%`;

      for (let i = 1; i <= totalSteps; i++) {
        const pill = document.getElementById(`pill-${i}`);
        if (i === currentStep) {
          pill.className = 'step-pill text-left px-2.5 py-1.5 rounded-xl text-xs font-bold bg-clinical-600 text-white shadow-sm transition';
        } else if (i < currentStep) {
          pill.className = 'step-pill text-left px-2.5 py-1.5 rounded-xl text-xs font-semibold bg-tealaccent-50 text-tealaccent-800 border border-tealaccent-200 transition';
        } else {
          pill.className = 'step-pill text-left px-2.5 py-1.5 rounded-xl text-xs font-medium bg-white text-slate-500 border border-slate-200 transition';
        }
      }

      const btnPrev = document.getElementById('btn-prev');
      const btnNext = document.getElementById('btn-next');
      const btnNextText = document.getElementById('btn-next-text');

      btnPrev.classList.toggle('invisible', currentStep === 1);

      if (currentStep === 5) {
        btnNext.classList.remove('hidden');
        btnNextText.textContent = 'Завершить и отправить';
      } else if (currentStep === 6) {
        btnNext.classList.add('hidden');
      } else {
        btnNext.classList.remove('hidden');
        btnNextText.textContent = 'Продолжить';
      }

      if (currentStep === 6) {
        finalizeAndRenderSummary();
      }

      document.getElementById('assessment-wizard').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function nextStep() {
      if (!validateStep(currentStep)) return;
      if (currentStep < totalSteps) {
        goToStep(currentStep + 1);
      }
    }

    function prevStep() {
      hideValidationError();
      if (currentStep > 1) {
        goToStep(currentStep - 1);
      }
    }

    function tryJumpToStep(targetStep) {
      if (targetStep < currentStep) {
        hideValidationError();
        goToStep(targetStep);
      } else if (targetStep === currentStep + 1) {
        nextStep();
      }
    }

    // ==================== PROTOCOL SCORING WITH MISSING VALUE RULES ====================
    function getItemNumericOrNull(itemId) {
      const skipped = document.getElementById(`skip-${itemId}`)?.checked;
      if (skipped) return null;
      return Number(document.getElementById(itemId).value);
    }

    function buildProtocolPayload() {
      const participantId = document.getElementById('participant-id').value.trim().toUpperCase();
      const visitId = document.getElementById('visit-id').value;
      const nowIso = new Date().toISOString();
      const recordUuid = `REC-${Date.now().toString(36).toUpperCase()}-${Math.floor(100 + Math.random() * 900)}`;

      // 1. GCPS (0-10 items -> CPI 0-100 & Interference 0-100)
      const painNow = getItemNumericOrNull('gcps_now');
      const painWorst = getItemNumericOrNull('gcps_worst');
      const painAvg = getItemNumericOrNull('gcps_avg');
      const validPainVals = [painNow, painWorst, painAvg].filter(v => v !== null);
      // Standard CPI = mean of 3 pain intensity items * 10 (valid if >= 2 items answered)
      const cpi0_100 = validPainVals.length >= 2
        ? Math.round((validPainVals.reduce((a, b) => a + b, 0) / validPainVals.length) * 10)
        : null;

      const interfDaily = getItemNumericOrNull('gcps_interf_daily');
      const interfSocial = getItemNumericOrNull('gcps_interf_social');
      const interfWork = getItemNumericOrNull('gcps_interf_work');
      const validInterfVals = [interfDaily, interfSocial, interfWork].filter(v => v !== null);
      const interfMean0_100 = validInterfVals.length >= 2
        ? Math.round((validInterfVals.reduce((a, b) => a + b, 0) / validInterfVals.length) * 10)
        : null;

      // 2. Pain Drawing
      const zones = Array.from(selectedPainZones);

      // 3. JFLS-8 (valid mean if at least 6 of 8 items answered per DC/TMD scoring rules)
      const jflsItemsMap = {};
      const validJflsVals = [];
      JFLS8_ITEMS.forEach(item => {
        const val = getItemNumericOrNull(item.id);
        jflsItemsMap[item.id] = val === null ? 'MISSING' : val;
        if (val !== null) validJflsVals.push(val);
      });
      const jflsMean0_10 = validJflsVals.length >= 6
        ? Number((validJflsVals.reduce((a, b) => a + b, 0) / validJflsVals.length).toFixed(2))
        : null;

      // 4. PHQ-4 (0-12 total; Anxiety 0-6, Depression 0-6)
      const p1 = Number(document.querySelector('input[name="phq_1"]:checked').value);
      const p2 = Number(document.querySelector('input[name="phq_2"]:checked').value);
      const p3 = Number(document.querySelector('input[name="phq_3"]:checked').value);
      const p4 = Number(document.querySelector('input[name="phq_4"]:checked').value);
      const anxiety0_6 = p1 + p2;
      const depression0_6 = p3 + p4;
      const phq4Total0_12 = anxiety0_6 + depression0_6;
      const safetyFlag = depression0_6 >= 3 || phq4Total0_12 >= 6;

      // 5. Missing status summary
      const skippedIds = [...GCPS_ITEMS, ...JFLS8_ITEMS]
        .filter(item => document.getElementById(`skip-${item.id}`).checked)
        .map(item => item.id);
      const missingStatus = skippedIds.length === 0
        ? 'COMPLETE'
        : `PARTIAL (${skippedIds.length} пропущено: ${skippedIds.join(', ')})`;

      const treatmentChange = document.querySelector('input[name="treatment-change"]:checked').value;
      const treatmentNotes = document.getElementById('treatment-notes').value.trim();

      return {
        record_uuid: recordUuid,
        source: 'patient_portal',
        instrument_version: 'DC-TMD-AxisII-v1.2',
        participant_id: participantId,
        visit_id: visitId,
        assessment_datetime: nowIso,
        consent_status: 'SIGNED',
        consent_timestamp: consentTimestampISO || nowIso,
        age_18_plus: true,
        acute_trauma_exclusion: 'NO',
        gcps: {
          pain_now: painNow === null ? 'MISSING' : painNow,
          pain_worst: painWorst === null ? 'MISSING' : painWorst,
          pain_avg: painAvg === null ? 'MISSING' : painAvg,
          cpi_0_100: cpi0_100 === null ? 'MISSING' : cpi0_100,
          interf_daily: interfDaily === null ? 'MISSING' : interfDaily,
          interf_social: interfSocial === null ? 'MISSING' : interfSocial,
          interf_work: interfWork === null ? 'MISSING' : interfWork,
          interf_mean_0_100: interfMean0_100 === null ? 'MISSING' : interfMean0_100
        },
        pain_drawing_count: zones.length,
        pain_drawing_zones: zones,
        jfls8: {
          mean_0_10: jflsMean0_10 === null ? 'MISSING' : jflsMean0_10,
          answered_count: validJflsVals.length,
          total_items: JFLS8_ITEMS.length,
          items: jflsItemsMap
        },
        phq4: {
          total_0_12: phq4Total0_12,
          anxiety_0_6: anxiety0_6,
          depression_0_6: depression0_6,
          safety_flag: safetyFlag
        },
        treatment_change: treatmentChange,
        treatment_notes: treatmentNotes,
        missing_status: missingStatus,
        disclaimer: 'Исследовательский инструмент мониторинга симптомов (DC/TMD Axis II). Не заменяет очный осмотр врача и не устанавливает автоматический диагноз.'
      };
    }

    function finalizeAndRenderSummary() {
      const payload = buildProtocolPayload();
      lastSubmittedRecord = payload;

      // Render Summary Cards (Separate Domains)
      document.getElementById('record-uuid-badge').textContent = `ID: ${payload.record_uuid}`;
      document.getElementById('summary-id').textContent = `${payload.participant_id} • ${payload.visit_id}`;
      document.getElementById('summary-consent-ts').textContent = payload.consent_timestamp;
      document.getElementById('summary-missing-status').textContent = payload.missing_status;

      // Trigger Automatic Submission to Google Sheets
      submitToGoogleSheets();
    }

    async function submitToGoogleSheets() {
      const payload = lastSubmittedRecord || buildProtocolPayload();
      const endpoint = getSavedEndpoint();
      const card = document.getElementById('sync-status-card');
      const iconWrap = document.getElementById('sync-icon-wrap');
      const title = document.getElementById('sync-status-title');
      const desc = document.getElementById('sync-status-desc');
      const retryActions = document.getElementById('sync-retry-actions');

      card.className = 'p-5 rounded-2xl bg-clinical-50 border border-clinical-200 flex items-start gap-3.5';
      iconWrap.className = 'w-10 h-10 rounded-xl bg-clinical-600 text-white flex items-center justify-center shrink-0';
      iconWrap.innerHTML = '<i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i>';
      title.textContent = 'Отправляем ваши ответы...';
      desc.textContent = 'Пожалуйста, не закрывайте страницу. Это может занять до минуты.';
      retryActions.classList.add('hidden');
      lucide.createIcons();

      try {
        await sendRecord(endpoint, payload);
        card.className = 'p-5 rounded-2xl bg-emerald-50 border border-emerald-200 flex items-start gap-3.5';
        iconWrap.className = 'w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0';
        iconWrap.innerHTML = '<i data-lucide="check-circle" class="w-6 h-6"></i>';
        title.textContent = 'Ответы отправлены. Спасибо!';
        desc.textContent = 'Ваша анкета передана исследователю.';
        retryActions.classList.add('hidden');
        localStorage.removeItem(STORAGE_KEY_DRAFT);
        localStorage.removeItem(STORAGE_KEY_PENDING);
      } catch (err) {
        try { localStorage.setItem(STORAGE_KEY_PENDING, JSON.stringify(payload)); } catch (e) {}
        card.className = 'p-5 rounded-2xl bg-rose-50 border border-rose-200 flex items-start gap-3.5';
        iconWrap.className = 'w-10 h-10 rounded-xl bg-rose-600 text-white flex items-center justify-center shrink-0';
        iconWrap.innerHTML = '<i data-lucide="wifi-off" class="w-5 h-5"></i>';
        title.textContent = 'Не удалось отправить ответы';
        desc.textContent = 'Проверьте интернет и нажмите «Повторить отправку». Ваши ответы сохранены на этом устройстве и отправятся автоматически, когда связь появится. Если не получается, сохраните копию и передайте её врачу.';
        retryActions.classList.remove('hidden');
      } finally {
        lucide.createIcons();
      }
    }

    // ==================== DOWNLOAD LOCAL BACKUP (.JSON / .TXT) ====================
    function downloadReport(format) {
      const data = lastSubmittedRecord || buildProtocolPayload();
      let content = '';
      let mimeType = 'text/plain;charset=utf-8';
      let ext = 'txt';

      if (format === 'json') {
        content = JSON.stringify(data, null, 2);
        mimeType = 'application/json;charset=utf-8';
        ext = 'json';
      } else {
        content = [
          '====================================================================',
          'ПРОТОКОЛ МОНИТОРИНГА «КЛИНИЧЕСКИЙ КОМПАС» (DC/TMD AXIS II)',
          '====================================================================',
          `ID записи: ${data.record_uuid}`,
          `Участник (participant_id): ${data.participant_id}`,
          `Визит (visit_id): ${data.visit_id}`,
          `Дата/время заполнения (ISO): ${data.assessment_datetime}`,
          `Согласие (consent_status): ${data.consent_status} (${data.consent_timestamp})`,
          `Статус полноты (missing_status): ${data.missing_status}`,
          '',
          '1. ТЯЖЕСТЬ И ВЛИЯНИЕ БОЛИ (GCPS)',
          `   - CPI интенсивности боли (0-100): ${data.gcps.cpi_0_100}`,
          `   - Боль сейчас / Макс / Средняя (0-10): ${data.gcps.pain_now} / ${data.gcps.pain_worst} / ${data.gcps.pain_avg}`,
          `   - Среднее влияние боли (0-100): ${data.gcps.interf_mean_0_100}`,
          '',
          '2. ЛОКАЛИЗАЦИЯ БОЛИ (PAIN DRAWING)',
          `   - Количество зон: ${data.pain_drawing_count}`,
          `   - Коды зон: ${data.pain_drawing_zones.join(', ') || 'Не отмечены'}`,
          '',
          '3. ОГРАНИЧЕНИЯ ФУНКЦИИ ЧЕЛЮСТИ (JFLS-8)',
          `   - Средний балл JFLS-8 (0-10): ${data.jfls8.mean_0_10}`,
          `   - Отвечено пунктов: ${data.jfls8.answered_count} из ${data.jfls8.total_items}`,
          '',
          '4. ПСИХОСОЦИАЛЬНЫЙ СКРИНИНГ (PHQ-4)',
          `   - Общий балл PHQ-4 (0-12): ${data.phq4.total_0_12}`,
          `   - Подшкала тревоги (0-6): ${data.phq4.anxiety_0_6}`,
          `   - Подшкала депрессии (0-6): ${data.phq4.depression_0_6}`,
          `   - Флаг плана безопасности: ${data.phq4.safety_flag ? 'ТРЕБУЕТ ВНИМАНИЯ ВРАЧА' : 'НОРМА'}`,
          '',
          '5. КЛИНИЧЕСКИЙ КОНТЕКСТ',
          `   - Изменение лечения: ${data.treatment_change}`,
          `   - Комментарий: ${data.treatment_notes || 'Нет'}`,
          '',
          '--------------------------------------------------------------------',
          data.disclaimer,
          '===================================================================='
        ].join('\n');
      }

      const blob = new Blob([content], { type: mimeType });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Compass_${data.participant_id}_${data.visit_id}.${ext}`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }


    // Initialize everything on DOM ready
    window.addEventListener('DOMContentLoaded', () => {
      initEndpointFromUrlOrStorage();
      initDynamicSections();
      restoreDraft();
      syncPainZonesUI();
    });
  </script>
