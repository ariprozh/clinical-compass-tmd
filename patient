<!DOCTYPE html>
<html lang="ru" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="robots" content="noindex" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Анкета участника: ВНЧС (DC/TMD Axis II)</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <!-- Lucide Icons -->
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.453.0/dist/umd/lucide.min.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            clinical: {
              50: '#f0f7ff',
              100: '#e0effe',
              200: '#bae0fd',
              300: '#7cc5fb',
              400: '#38a3f5',
              500: '#167fd4',
              600: '#0F4C81',
              700: '#0c3e6b',
              800: '#093257',
              900: '#072745',
            },
            tealaccent: {
              50: '#f0fdfa',
              100: '#ccfbf1',
              500: '#14b8a6',
              600: '#0D9488',
              700: '#0f766e',
            },
            slatebg: '#f4f7f9',
          }
        }
      }
    };
  </script>
  <style>
    /* Custom range slider styling for clean medical UI */
    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      background: transparent;
      cursor: pointer;
    }
    input[type="range"]:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }
    input[type="range"]::-webkit-slider-runnable-track {
      height: 8px;
      border-radius: 999px;
      background: #e2e8f0;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      margin-top: -6px;
      background-color: #0F4C81;
      height: 20px;
      width: 20px;
      border-radius: 999px;
      border: 3px solid #ffffff;
      box-shadow: 0 2px 6px rgba(15, 23, 42, 0.25);
      transition: transform 0.15s ease, background-color 0.15s ease;
    }
    input[type="range"]:not(:disabled)::-webkit-slider-thumb:hover {
      transform: scale(1.12);
      background-color: #0D9488;
    }
    /* Interactive SVG anatomical zone hover & active states */
    .pain-zone {
      cursor: pointer;
      transition: fill 0.2s ease, stroke 0.2s ease, opacity 0.2s ease;
    }
    .pain-zone:hover {
      opacity: 0.85;
      stroke: #dc2626;
      stroke-width: 2.5px;
    }
    .pain-zone.selected {
      fill: rgba(239, 68, 68, 0.45) !important;
      stroke: #dc2626 !important;
      stroke-width: 2.5px !important;
    }
  </style>
</head>
<body class="bg-slatebg text-slate-800 font-sans antialiased selection:bg-clinical-200 selection:text-clinical-900">

  <!-- Top Medical Disclaimer Banner -->
  <div class="bg-clinical-900 text-clinical-50 text-xs sm:text-sm py-2.5 px-4 border-b border-clinical-800">
    <div class="max-w-6xl mx-auto flex items-center justify-center gap-2 text-center">
      <i data-lucide="shield-alert" class="w-4 h-4 text-amber-300 shrink-0"></i>
      <span>
        <strong>Исследовательский инструмент мониторинга симптомов (DC/TMD Axis II).</strong> Не заменяет очный осмотр врача и не устанавливает автоматический диагноз.
      </span>
    </div>
  </div>

  <!-- Navigation Header -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-sm">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">
      <a href="#" class="flex items-center gap-2.5 group shrink-0">
        <div class="w-9 h-9 rounded-xl bg-clinical-600 text-white flex items-center justify-center shadow-sm group-hover:bg-clinical-700 transition">
          <i data-lucide="compass" class="w-5 h-5"></i>
        </div>
        <div>
          <span class="font-bold text-slate-900 text-base sm:text-lg tracking-tight block leading-none">Клинический Компас</span>
          <span class="text-[11px] font-semibold text-tealaccent-600 tracking-wide uppercase">DC/TMD Axis II • ВНЧС</span>
        </div>
      </a>


      <div class="flex items-center gap-2">
        <a href="#assessment-wizard"
          class="inline-flex items-center gap-1.5 px-3.5 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold text-white bg-clinical-600 hover:bg-clinical-700 shadow-sm transition">
          <span>Начать анкетирование</span>
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-10 pb-12 sm:pt-14 sm:pb-16 bg-gradient-to-b from-white via-clinical-50/50 to-slatebg border-b border-slate-200/60">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-tealaccent-50 text-tealaccent-700 text-xs font-semibold border border-tealaccent-100">
        <span class="w-2 h-2 rounded-full bg-tealaccent-600 animate-pulse"></span>
        Анкета для пациентов • около 10 минут
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
        Анкета о боли и функции <span class="text-clinical-600">височно-нижнечелюстного сустава</span>
      </h1>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        Вам нужно подписать информированное согласие и ответить на вопросы о боли, движениях челюсти и самочувствии. Ответы помогут врачу следить за динамикой между визитами.
      </p>
      <div class="p-4 rounded-2xl bg-amber-50/90 border border-amber-200/90 flex items-start gap-3">
        <i data-lucide="info" class="w-5 h-5 text-amber-600 shrink-0 mt-0.5"></i>
        <p class="text-xs sm:text-sm text-amber-900 leading-relaxed">
          Анкета <strong>не заменяет очный осмотр врача</strong> и не ставит диагноз. При резком ухудшении состояния обратитесь к врачу, при угрозе жизни вызовите скорую помощь по номеру 112.
        </p>
      </div>
      <a href="#assessment-wizard" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl text-base font-semibold text-white bg-clinical-600 hover:bg-clinical-700 shadow-lg shadow-clinical-600/20 transition">
        <i data-lucide="clipboard-check" class="w-5 h-5"></i>
        Начать анкетирование
      </a>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-slate-500 font-medium">
        <span class="flex items-center gap-1.5"><i data-lucide="lock" class="w-4 h-4 text-clinical-600"></i> ФИО не передаётся, используется только код участника</span>
        <span class="flex items-center gap-1.5"><i data-lucide="save" class="w-4 h-4 text-clinical-600"></i> Ответы сохраняются, можно вернуться позже</span>
      </div>
    </div>
  </section>

  <!-- MAIN INTERACTIVE MODULE: DC/TMD AXIS II ASSESSMENT WIZARD -->
  <section id="assessment-wizard" class="py-16 sm:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <!-- Wizard Header -->
      <div class="text-center mb-8">
        <div class="inline-flex flex-wrap items-center justify-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-clinical-100 text-clinical-800 text-xs font-bold uppercase tracking-wider">
            <i data-lucide="clipboard-list" class="w-3.5 h-3.5"></i> Протокол DC/TMD Axis II
          </span>
          <span id="draft-saved-badge" class="hidden inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-tealaccent-50 text-tealaccent-700 border border-tealaccent-200 text-xs font-medium">
            <i data-lucide="check" class="w-3 h-3"></i> Черновик сохранён
          </span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mt-2.5">Анкетирование участника исследования</h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2 max-w-2xl mx-auto">
          Заполните 6 последовательных шагов. Ваши ответы автоматически сохраняются в браузере до момента отправки.
        </p>
      </div>

      <!-- Wizard Card Container -->
      <div class="bg-white rounded-3xl border border-slate-200 shadow-xl shadow-slate-200/60 overflow-hidden">
        
        <!-- Progress Bar & Stepper -->
        <div class="bg-slate-50 border-b border-slate-200/80 px-5 sm:px-8 py-5">
          <div class="flex items-center justify-between text-xs font-semibold text-slate-500 mb-2.5">
            <span id="step-label" class="text-clinical-700 font-bold">Шаг 1 из 6: Информированное согласие и ID</span>
            <span id="step-percent">17%</span>
          </div>
          <div class="w-full h-2.5 bg-slate-200 rounded-full overflow-hidden">
            <div id="progress-bar" class="h-full bg-clinical-600 rounded-full transition-all duration-300" style="width: 16.66%"></div>
          </div>

          <!-- Step Pills (Desktop/Tablet) -->
          <div class="hidden sm:grid grid-cols-6 gap-2 mt-4">
            <button type="button" onclick="tryJumpToStep(1)" id="pill-1" class="step-pill text-left px-2.5 py-1.5 rounded-xl text-xs font-bold bg-clinical-600 text-white transition">
              1. Согласие
            </button>
            <button type="button" onclick="tryJumpToStep(2)" id="pill-2" class="step-pill text-left px-2.5 py-1.5 rounded-xl text-xs font-medium bg-white text-slate-500 border border-slate-200 transition">
              2. Боль (GCPS)
            </button>
            <button type="button" onclick="tryJumpToStep(3)" id="pill-3" class="step-pill text-left px-2.5 py-1.5 rounded-xl text-xs font-medium bg-white text-slate-500 border border-slate-200 transition">
              3. Карта боли
            </button>
            <button type="button" onclick="tryJumpToStep(4)" id="pill-4" class="step-pill text-left px-2.5 py-1.5 rounded-xl text-xs font-medium bg-white text-slate-500 border border-slate-200 transition">
              4. Функция (JFLS-8)
            </button>
            <button type="button" onclick="tryJumpToStep(5)" id="pill-5" class="step-pill text-left px-2.5 py-1.5 rounded-xl text-xs font-medium bg-white text-slate-500 border border-slate-200 transition">
              5. PHQ-4 и фон
            </button>
            <button type="button" onclick="tryJumpToStep(6)" id="pill-6" class="step-pill text-left px-2.5 py-1.5 rounded-xl text-xs font-medium bg-white text-slate-500 border border-slate-200 transition">
              6. Отправка
            </button>
          </div>
        </div>

        <!-- Inline Validation / Error Banner -->
        <div id="validation-banner" class="hidden mx-5 sm:mx-8 mt-5 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-start gap-3">
          <i data-lucide="alert-circle" class="w-5 h-5 text-rose-600 shrink-0 mt-0.5"></i>
          <div>
            <p class="font-semibold">Требуется подтверждение обязательных полей:</p>
            <p id="validation-message" class="text-xs sm:text-sm mt-0.5 text-rose-700"></p>
          </div>
        </div>

        <!-- WIZARD FORM BODY -->
        <form id="compass-form" class="p-5 sm:p-8" onsubmit="return false;">

          <!-- ==================== STEP 1: INFORMED CONSENT & IDENTIFICATION ==================== -->
          <div id="step-1" class="wizard-step space-y-6">
            <div class="border-b border-slate-100 pb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-tealaccent-600">Этап 7 протокола • Обязательный допуск</span>
              <h3 class="text-xl font-bold text-slate-900 mt-0.5">Шаг 1. Информированное согласие и идентификация участника</h3>
              <p class="text-sm text-slate-600 mt-1">
                Для защиты ваших персональных данных не вводите ФИО. Используйте только присвоенный исследовательский код (<code>participant_id</code>).
              </p>
            </div>

            <!-- Participant ID & Visit Selection -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <!-- Participant ID -->
              <div class="space-y-2">
                <label for="participant-id" class="block text-sm font-semibold text-slate-800">
                  Код участника (<code>participant_id</code>) <span class="text-rose-500">*</span>
                </label>
                <div class="flex gap-2">
                  <input type="text" id="participant-id" placeholder="Например: TMD-001" oninput="saveDraft()"
                    class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm font-mono uppercase focus:outline-none focus:ring-2 focus:ring-clinical-500 focus:border-clinical-500" />
                  <button type="button" onclick="generateDemoCode()"
                    class="shrink-0 px-3 py-2.5 rounded-xl bg-clinical-50 hover:bg-clinical-100 text-clinical-700 border border-clinical-200 text-xs font-semibold transition"
                    title="Сгенерировать псевдонимизированный демо-код">
                    Сгенерировать демо-код
                  </button>
                </div>
                <p class="text-xs text-slate-500">Выдаётся врачом-исследователем (таблица соответствия хранится отдельно в клинике).</p>
              </div>

              <!-- Visit ID Selector -->
              <div class="space-y-2">
                <label for="visit-id" class="block text-sm font-semibold text-slate-800">
                  Визит наблюдения (<code>visit_id</code>) <span class="text-rose-500">*</span>
                </label>
                <select id="visit-id" onchange="saveDraft()"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-clinical-500 focus:border-clinical-500">
                  <option value="V0_Baseline">V0_Baseline — Исходный визит (Неделя 0)</option>
                  <option value="V1_Week2">V1_Week2 — Повторный мониторинг (Неделя 2)</option>
                  <option value="V2_Week4">V2_Week4 — Повторный мониторинг (Неделя 4)</option>
                  <option value="V3_Week6">V3_Week6 — Повторный мониторинг (Неделя 6)</option>
                  <option value="V4_Week8">V4_Week8 — Завершающий мониторинг (Неделя 8)</option>
                </select>
                <p class="text-xs text-slate-500">Выберите точку графика продольного наблюдения (6–8 недель).</p>
              </div>
            </div>

            <!-- Structured Participant Information Sheet & Informed Consent Box -->
            <div class="rounded-2xl border border-clinical-200 bg-clinical-50/40 overflow-hidden">
              <div class="px-4 py-3 bg-clinical-100/70 border-b border-clinical-200 flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-clinical-900 flex items-center gap-1.5">
                  <i data-lucide="file-text" class="w-4 h-4 text-clinical-700"></i>
                  Информационный лист участника исследования
                </span>
                <span class="text-[11px] font-medium text-clinical-700">Версия протокола: IC-v1.0</span>
              </div>
              <div class="p-4 max-h-48 overflow-y-auto text-xs sm:text-sm text-slate-700 space-y-2.5 leading-relaxed">
                <p>
                  <strong>1. Цель исследования:</strong> Оценка практической осуществимости и информативности цифрового продольного мониторинга орофациальной боли, ограничений функции нижней челюсти и психосоциальных симптомов у взрослых пациентов с височно-нижнечелюстными расстройствами (ВНЧС / TMD).
                </p>
                <p>
                  <strong>2. Добровольность участия и отзыв согласия:</strong> Ваше участие является полностью добровольным. Вы вправе отказаться от участия или прекратить заполнение анкет в любой момент без объяснения причин и без какого-либо ущерба для качества вашей медицинской помощи.
                </p>
                <p>
                  <strong>3. Псевдонимизация и конфиденциальность:</strong> В облачную исследовательскую таблицу передаются только обезличенные ответы, привязанные к вашему исследовательскому коду (<code>participant_id</code>). Ваши ФИО, телефон и паспортные данные в систему не вводятся.
                </p>
                <p>
                  <strong>4. Клинические ограничения:</strong> Цифровая платформа не ставит медицинский диагноз и не назначает лечение. Все клинические решения принимаются вашим лечащим врачом по итогам очного осмотра (протокол DC/TMD Axis I).
                </p>
              </div>
            </div>

            <!-- Mandatory Consent & Inclusion Checkboxes -->
            <div class="space-y-3 pt-1">
              <label class="flex items-start gap-3 p-3.5 rounded-2xl bg-slate-50 border border-slate-200/90 cursor-pointer hover:bg-slate-100/70 transition">
                <input type="checkbox" id="age-18-check" onchange="handleConsentCheckboxChange()" class="mt-1 w-4 h-4 rounded text-clinical-600 focus:ring-clinical-500 border-slate-300" />
                <span class="text-xs sm:text-sm text-slate-800 leading-relaxed">
                  <strong>1. Критерий возраста (<code>age_18_plus</code>) <span class="text-rose-500">*</span>:</strong> Мне исполнилось 18 лет.
                </span>
              </label>

              <label class="flex items-start gap-3 p-3.5 rounded-2xl bg-slate-50 border border-slate-200/90 cursor-pointer hover:bg-slate-100/70 transition">
                <input type="checkbox" id="acute-trauma-check" onchange="handleConsentCheckboxChange()" class="mt-1 w-4 h-4 rounded text-clinical-600 focus:ring-clinical-500 border-slate-300" />
                <span class="text-xs sm:text-sm text-slate-800 leading-relaxed">
                  <strong>2. Критерий исключения (<code>acute_trauma_exclusion = NO</code>) <span class="text-rose-500">*</span>:</strong> У меня отсутствует острая челюстно-лицевая травма или неотложное состояние, требующее экстренной помощи.
                </span>
              </label>

              <label class="flex items-start gap-3 p-3.5 rounded-2xl bg-tealaccent-50/60 border border-tealaccent-200 cursor-pointer hover:bg-tealaccent-50 transition">
                <input type="checkbox" id="consent-signed-check" onchange="handleConsentCheckboxChange()" class="mt-1 w-4 h-4 rounded text-tealaccent-600 focus:ring-tealaccent-500 border-tealaccent-400" />
                <span class="text-xs sm:text-sm text-slate-900 leading-relaxed">
                  <strong>3. Информированное согласие (<code>consent_status = SIGNED</code>) <span class="text-rose-500">*</span>:</strong> Я прочитал(а) информацию об исследовании и даю добровольное информированное согласие на участие и обработку обезличенных данных.
                </span>
              </label>

              <!-- Live Consent ISO Timestamp Display -->
              <div id="consent-timestamp-box" class="hidden px-4 py-2.5 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-900 flex items-center justify-between gap-2">
                <span class="flex items-center gap-1.5 font-semibold">
                  <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i>
                  Согласие подтверждено (<code>SIGNED</code>)
                </span>
                <span class="font-mono text-[11px]" id="consent-timestamp-display">—</span>
              </div>
            </div>
          </div>

          <!-- ==================== STEP 2: GCPS (6 ITEMS, 0-10, CPI 0-100, SKIP SUPPORT) ==================== -->
          <div id="step-2" class="wizard-step hidden space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-4">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-rose-600">Шкала тяжести боли GCPS (последние 30 дней)</span>
                <h3 class="text-xl font-bold text-slate-900 mt-0.5">Шаг 2. Интенсивность и влияние орофациальной боли</h3>
              </div>
              <span class="text-xs font-medium px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 self-start">0 = Нет боли • 10 = Нестерпимая</span>
            </div>

            <p class="text-xs sm:text-sm text-slate-600 bg-slate-50 p-3.5 rounded-2xl border border-slate-200/70">
              Если какой-либо вопрос неприменим или вы затрудняетесь ответить, используйте переключатель <strong>«Пропустить вопрос»</strong> — система зафиксирует пропуск (<code>MISSING</code>), а не ноль баллов.
            </p>

            <div class="space-y-5" id="gcps-questions-container">
              <!-- Populated via JS with all 6 GCPS items + Skip checkbox -->
            </div>
          </div>

          <!-- ==================== STEP 3: INTERACTIVE PAIN DRAWING (11 ZONES) ==================== -->
          <div id="step-3" class="wizard-step hidden space-y-6">
            <div class="border-b border-slate-100 pb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-amber-600">Локализация симптомов (Pain Drawing)</span>
              <h3 class="text-xl font-bold text-slate-900 mt-0.5">Шаг 3. Интерактивная схема локализации боли</h3>
              <p class="text-sm text-slate-600 mt-1">
                Нажмите на анатомические зоны на схеме (Правый профиль, Фас, Левый профиль), где вы испытывали боль за последние 30 дней, или выберите из списка зон.
              </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
              <!-- Interactive SVG Anatomical Maps -->
