    const DEFAULT_ENDPOINT = 'https://script.google.com/macros/s/AKfycbzl-9K311bAqANDZjtB_1m81fiz9LaaXafEmasgb9iuqEBGZhf-F6u6kD_r1lwIFfkj5g/exec';
    const STORAGE_KEY_PENDING = 'clinical_compass_pending_v1';

    function getSavedEndpoint() {
      return (localStorage.getItem(STORAGE_KEY_ENDPOINT) || '').trim() || DEFAULT_ENDPOINT;
    }

    function initEndpointFromUrlOrStorage() {
      const params = new URLSearchParams(window.location.search);
      const urlEndpoint = params.get('endpoint');
      if (urlEndpoint && urlEndpoint.startsWith('https://script.google.com/')) {
        localStorage.setItem(STORAGE_KEY_ENDPOINT, urlEndpoint.trim());
      }
      flushPending();
    }

    const sleep = (ms) => new Promise(r => setTimeout(r, ms));

    // Отправка с повторами: при большой нагрузке (до 150 человек) Google может ответить с задержкой
    async function sendRecord(endpoint, payload, attempts = 4) {
      let lastErr = null;
      for (let i = 0; i < attempts; i++) {
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 30000);
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify(payload),
            signal: ctrl.signal
          });
          const json = await res.json();
          if (['success', 'ok', 'duplicate'].includes(json.status)) return json;
          throw new Error(json.message || 'Ошибка записи на стороне сервера');
        } catch (err) {
          lastErr = err;
          if (i < attempts - 1) await sleep(1500 * Math.pow(2, i) + Math.random() * 1500);
        } finally {
          clearTimeout(timer);
        }
      }
      throw lastErr || new Error('Нет связи с сервером');
    }

    // Если отправка не удалась, запись ждёт в браузере и уйдёт при следующем открытии страницы или появлении сети
    async function flushPending() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY_PENDING);
        if (!raw || !navigator.onLine) return;
        await sendRecord(getSavedEndpoint(), JSON.parse(raw), 2);
        localStorage.removeItem(STORAGE_KEY_PENDING);
      } catch (e) { /* повторим позже */ }
    }
    window.addEventListener('online', flushPending);


